# STEP 1: 
ign = input("IGN: ")
rank = input("Rank: ")

# STEP 2: 
print("\n--- HERO ROSTER ---")
print("1. Layla [Marksman]\n2. Tigreal [Tank]\n3. Gusion [Assassin]\n4. Kagura [Mage]\n5. Chou [Fighter]")

# Prepare variables to track totals
match_count = 0
wins = 0
best_kda = -1.0
best_match_info = ""

# STEP 3: 
for i in range(1, 5):
    print(f"\n--- MATCH {i} ---")
    hero_num = int(input("Hero number (0 to skip): "))

    if hero_num == 0:
        continue # Skip to the next match
    
    # Hero mapping (simple logic)
    if hero_num == 1: hero_name = "Layla"
    elif hero_num == 2: hero_name = "Tigreal"
    elif hero_num == 3: hero_name = "Gusion"
    elif hero_num == 4: hero_name = "Kagura"
    else: hero_name = "Chou"

    # Input stats
    k = int(input("Kills: "))
    d = int(input("Deaths: "))
    a = int(input("Assists: "))
    res = str(input("Result (W/L): ")).upper()

    # Calculate KDA
    divisor = d if d > 0 else 1
    kda = (k + a) / divisor
    match_count += 1

    # Performance Tag
    if kda >= 5 and res == "W":
        tag = "DOMINATION!"
    elif kda >= 5 and res == "L":
        tag = "Carried Hard"
    elif kda < 5 and res == "W":
        tag = "Team Effort"
    else:
        tag = "Better Luck Next Game"

    # Tracking Wins and Best Match
    if res == "W":
        wins += 1
    
    if kda > best_kda:
        best_kda = kda
        best_match_info = f"[{i}] {hero_name} with KDA {kda:.2f}"

    print(f"KDA={kda:.2f} -- {tag}")

# STEP 4: Final Summary 
print("\n" + "="*35)
print(f"In-game name (IGN): {ign}")
print("="*35)
print(f"Current rank: {rank}")

if match_count > 0:
    win_rate = (wins / match_count) * 100
    print(f"Best match: {best_match_info}")
    print(f"Win rate: {wins}/{match_count} x 100 = {int(win_rate)}%")
else:
    print("No matches played.")

